MY_GITHUB_USERNAME=huynguyen-everfit
GITHUB_WEBHOOK_SECRET=
ID_TO_DO=11
ID_IN_PROGRESS=21
ID_IN_REVIEW=41
ID_QA_READY=51
ID_QA_FAILED=71
ID_WILL_NOT_FIX=101
ID_IN_TEST=111
ID_QA_SUCCESS=141
BOT_URL=http://localhost:3000
PORT=3000
DRY_RUN=true
QA_NOTIFY_DELAY_MINUTES=20
SLACK_PREVIEW_CHANNEL=C0AUQ2G4FQ8
# Workspace subdomain used to build clickable thread links in previews.
# Take it from any Slack URL: https://everfitt.slack.com/archives/... → "everfitt".
# Unset = previews fall back to plain channel/ts text and the 👀 "Go to thread"
# link is omitted entirely.
SLACK_WORKSPACE=everfitt
# Comma-separated channel IDs to exclude from /tickets audit results
IGNORED_AUDIT_CHANNELS=C0AMZQ68TSP
# Comma-separated Slack user IDs whose messages should be ignored by the ✅ PR-approve flow
IGNORED_TEAMMATE=
GITHUB_TOKEN=
# ── 👀 reaction → Claude Code review (local-only feature) ──
# Parent directory holding your local clones; the bot runs the review in
# REVIEW_REPO_ROOT/<repo-name-from-the-PR-URL>. Unset = 👀 does nothing.
REVIEW_REPO_ROOT=/Users/huynguyen-mac-be/Everfit
# claude binary (absolute path if the bot isn't started from a login shell)
CLAUDE_BIN=claude
# Permission mode for the headless review run
REVIEW_PERMISSION_MODE=bypassPermissions
# Optional model override for the review run (e.g. opus)
REVIEW_CLAUDE_MODEL=
# Hard kill for a stuck review
REVIEW_TIMEOUT_MINUTES=30
# Comma-separated repo names the 👀 review is allowed to run on. Empty = no restriction.
REVIEW_ALLOWED_REPOS=